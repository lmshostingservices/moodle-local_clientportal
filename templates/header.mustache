{{!
    @template local_clientportal/header

    Client portal top bar and navigation. ui::header() wraps it in .cport-shell and opens .cport-main after it; ui::footer() closes both.

    Example context (json):
    {
        "clientname": "BHP",
        "logo": "https://example.com/logo.png",
        "homeurl": "#",
        "nav": [{"url": "#", "label": "Dashboard", "active": true}, {"url": "#", "label": "Learners", "active": false}],
        "clients": [],
        "hasclients": false,
        "username": "Pat Smith",
        "rolename": "Client manager",
        "logouturl": "#",
        "support": false,
        "adminurl": "#"
    }
}}
    {{#support}}
    <div class="cport-support alert alert-info d-flex justify-content-between align-items-center mb-0">
        <span>{{#str}}supportview, local_clientportal, {{clientname}}{{/str}}</span>
        <a class="btn btn-sm btn-outline-primary" href="{{adminurl}}">{{#str}}backtoclients, local_clientportal{{/str}}</a>
    </div>
    {{/support}}
    <header class="cport-bar">
        <a class="cport-brand" href="{{homeurl}}">
            {{#logo}}<img class="cport-logo" src="{{logo}}" alt="">{{/logo}}
            <span class="cport-brand-text">
                <span class="cport-client">{{clientname}}</span>
                <span class="cport-product">{{#str}}pluginname, local_clientportal{{/str}}</span>
            </span>
        </a>
        <div class="cport-bar-right">
            {{#hasclients}}
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-toggle="dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    {{#str}}switchclient, local_clientportal{{/str}}
                </button>
                <div class="dropdown-menu dropdown-menu-right dropdown-menu-end">
                    {{#clients}}<a class="dropdown-item{{#current}} active{{/current}}" href="{{url}}"{{#current}} aria-current="true"{{/current}}>{{name}}</a>{{/clients}}
                </div>
            </div>
            {{/hasclients}}
            <span class="cport-user">
                <span class="cport-user-name">{{username}}</span>
                <span class="cport-user-role">{{rolename}}</span>
            </span>
            <a class="btn btn-sm btn-outline-secondary" href="{{logouturl}}">{{#str}}logout{{/str}}</a>
        </div>
    </header>
    <nav class="cport-nav" aria-label="{{#str}}pluginname, local_clientportal{{/str}}">
        {{#nav}}<a class="cport-nav-link{{#active}} active{{/active}}" href="{{url}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>{{/nav}}
    </nav>
